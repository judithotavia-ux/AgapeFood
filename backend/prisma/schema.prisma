generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PapelUsuario {
  SUPER_ADMIN
  ADMIN
  GERENTE
  FUNCIONARIO
  GARCOM
}

enum StatusGarcom {
  ATIVO
  INATIVO
  FERIAS
  AFASTADO
}

enum TipoPedido {
  DELIVERY
  RETIRADA
  BALCAO
  MESA
}

enum StatusPedido {
  RECEBIDO
  PREPARANDO
  PRONTO
  SAIU_PARA_ENTREGA
  ENTREGUE
  CANCELADO
}

enum FormaPagamento {
  PIX
  CARTAO
  DINHEIRO
  VALE_ALIMENTACAO
  BOLETO
}

enum StatusCaixa {
  ABERTO
  FECHADO
}

enum TipoMovimentacaoCaixa {
  SANGRIA
  SUPRIMENTO
}

enum StatusReserva {
  CONFIRMADA
  CANCELADA
  CONCLUIDA
}

enum TipoCanalEntrega {
  MOTOBOY_PROPRIO
  IFOOD
  UBER_EATS
  NOVENTA_NOVE_FOOD
}

enum TipoMovimentacaoEstoque {
  ENTRADA
  SAIDA
  TRANSFERENCIA
  INVENTARIO
  PERDA
  QUEBRA
  CONSUMO_INTERNO
  PRODUCAO
  COMPRA
  VENDA
  AJUSTE
}

enum TipoCategoriaFinanceira {
  RECEITA
  DESPESA
}

enum TipoDesconto {
  PERCENTUAL
  FIXO
}

enum CanalCampanha {
  WHATSAPP
  EMAIL
  SMS
  INSTAGRAM
  FACEBOOK
  PUSH
  OUTRO
}

enum StatusCampanha {
  RASCUNHO
  ATIVA
  CONCLUIDA
}

enum StatusConta {
  PENDENTE
  PAGO
  VENCIDO
  CANCELADO
}

enum SetorProducao {
  COZINHA
  BAR
  CONFEITARIA
  PIZZARIA
  ACAI
  SALGADOS
  BALCAO
  GARCOM
  CAIXA
  DELIVERY
  OUTRO
}

enum TipoConexaoImpressora {
  USB
  REDE
  BLUETOOTH
}

enum StatusImpressora {
  ONLINE
  OFFLINE
  ATENCAO
}

enum TipoDocumentoImpressao {
  COMANDA_COZINHA
  COMANDA_GARCOM
  COMANDA_DELIVERY
  COMANDA_CAIXA
  CANCELAMENTO
  ALTERACAO
  TESTE
}

enum StatusPrintJob {
  PENDING
  PRINTING
  PRINTED
  FAILED
  RETRYING
  CANCELLED
}

enum PrioridadePrintJob {
  NORMAL
  ALTA
  URGENTE
  VIP
}

enum CicloAssinatura {
  MENSAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

enum StatusAssinatura {
  TRIAL
  ATIVA
  INADIMPLENTE
  CANCELADA
  PENDENTE
}

enum FormaPagamentoAssinatura {
  PIX
  BOLETO
  CARTAO
  INDEFINIDO
}

enum TipoEmpresa {
  RESTAURANTE
  LANCHONETE
  PIZZARIA
  HAMBURGUERIA
  CAFETERIA
  ACAITERIA
  PADARIA
  SORVETERIA
  FOOD_TRUCK
  DOCERIA
  MARMITARIA
  OUTRO
}

model Empresa {
  id          String   @id @default(uuid())
  nome        String
  slug        String   @unique
  logoUrl     String?
  corPrimaria String   @default("#D4AF37")
  ativo       Boolean  @default(true)
  criadoEm    DateTime @default(now())

  // Aba 1 - Dados da empresa
  razaoSocial        String?
  cnpj               String?      @unique
  inscricaoEstadual  String?
  inscricaoMunicipal String?
  dataFundacao       DateTime?
  tipoEmpresa        TipoEmpresa? @default(OUTRO)
  regimeTributario   String?
  ramoAtividade      String?
  descricao          String?      @db.Text

  // Aba 2 - Endereco
  cep         String?
  endereco    String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  estado      String?
  pais        String? @default("Brasil")

  // Aba 3 - Contatos
  telefone     String?
  whatsapp     String?
  emailContato String?
  site         String?
  instagram    String?
  facebook     String?
  tiktok       String?
  youtube      String?

  // Marketing - fidelidade
  percentualCashback       Decimal @default(0) @db.Decimal(5, 2)
  mensagemCardapioWhatsapp String? @db.Text

  // Termos legais
  termosAceitosEm DateTime?

  // Ágape IA — cada empresa configura e paga sua própria chave da Anthropic
  iaChaveAnthropic String? @db.Text

  usuarios              Usuario[]
  categorias            Categoria[]
  produtos              Produto[]
  pedidos               Pedido[]
  mesas                 Mesa[]
  caixas                Caixa[]
  reservas              Reserva[]
  motoboys              Motoboy[]
  zonasEntrega          ZonaEntrega[]
  canaisEntrega         CanalEntregaConfig[]
  contadorPedido        ContadorPedido?
  fornecedores          Fornecedor[]
  movimentacoesEstoque  MovimentacaoEstoque[]
  categoriasFinanceiras CategoriaFinanceira[]
  contasPagar           ContaPagar[]
  contasReceber         ContaReceber[]
  clientes              Cliente[]
  cupons                Cupom[]
  campanhas             Campanha[]
  avaliacoes            Avaliacao[]
  impressoras           Printer[]
  printJobs             PrintJob[]
  otpsCliente           OtpCliente[]
  assinatura            Assinatura?
  conversasIA           ConversaIA[]
  acoesIA               AcaoIA[]
  tarefasIA             TarefaIA[]
  configuracaoGorjeta   ConfiguracaoGorjeta?
  fechamentosGorjeta    FechamentoGorjeta[]
  limitesAprovacao      LimiteAprovacao[]
  aprovacoesGerenciais  AprovacaoGerencial[]
  perfisPersonalizados  PerfilPersonalizado[]
  permissoesTemporarias PermissaoTemporaria[]

  @@map("empresas")
}

model Plano {
  id        String          @id @default(uuid())
  nome      String
  descricao String?
  preco     Decimal         @db.Decimal(10, 2)
  ciclo     CicloAssinatura @default(MENSAL)
  ativo     Boolean         @default(true)
  ordem     Int             @default(0)
  criadoEm  DateTime        @default(now())

  assinaturas Assinatura[]

  @@map("planos")
}

model Assinatura {
  id                 String                   @id @default(uuid())
  status             StatusAssinatura         @default(TRIAL)
  formaPagamento     FormaPagamentoAssinatura @default(INDEFINIDO)
  inicioTrialEm      DateTime?
  fimTrialEm         DateTime?
  proximaCobrancaEm  DateTime?
  canceladaEm        DateTime?
  motivoCancelamento String?
  criadoEm           DateTime                 @default(now())
  atualizadoEm       DateTime                 @updatedAt

  asaasCustomerId     String?
  asaasSubscriptionId String?

  empresaId String  @unique
  empresa   Empresa @relation(fields: [empresaId], references: [id])
  planoId   String
  plano     Plano   @relation(fields: [planoId], references: [id])

  cobrancas Cobranca[]

  @@map("assinaturas")
}

model Cobranca {
  id             String                    @id @default(uuid())
  valor          Decimal                   @db.Decimal(10, 2)
  status         String
  vencimento     DateTime
  pagoEm         DateTime?
  formaPagamento FormaPagamentoAssinatura?
  asaasPaymentId String?                   @unique
  linkPagamento  String?                   @db.Text
  criadoEm       DateTime                  @default(now())

  assinaturaId String
  assinatura   Assinatura @relation(fields: [assinaturaId], references: [id])

  @@map("cobrancas")
}

model Usuario {
  id            String       @id @default(uuid())
  nome          String
  email         String       @unique
  senhaHash     String
  papel         PapelUsuario @default(FUNCIONARIO)
  ativo         Boolean      @default(true)
  criadoEm      DateTime     @default(now())
  ultimoLoginEm DateTime?

  cpf            String?   @unique
  rg             String?
  dataNascimento DateTime?
  telefone       String?
  fotoUrl        String?

  // Campos especificos de garcom (papel = GARCOM)
  nomeExibicao  String?
  whatsapp      String?
  dataAdmissao  DateTime?
  matricula     String?
  statusGarcom  StatusGarcom @default(ATIVO)
  observacoes   String?      @db.Text

  // Pesos padrao usados no rateio coletivo de gorjeta (regra PERCENTUAL / PONTOS)
  percentualRateioGorjeta Decimal? @db.Decimal(5, 2)
  pontosGorjeta           Int?

  // PIN curto (hash) usado pra aprovar excecao de desconto/cancelamento no caixa sem exigir a senha
  // completa - so preenchido por quem efetivamente aprova excecao (normalmente ADMIN/GERENTE).
  pinHash String?

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  perfilPersonalizadoId String?
  perfilPersonalizado   PerfilPersonalizado? @relation(fields: [perfilPersonalizadoId], references: [id])

  caixasAbertos        Caixa[]               @relation("CaixaAbertoPor")
  caixasFechados       Caixa[]               @relation("CaixaFechadoPor")
  movimentacoesCaixa   MovimentacaoCaixa[]
  movimentacoesEstoque MovimentacaoEstoque[]
  printLogs            PrintLog[]
  conversasIA          ConversaIA[]
  tokensResetSenha     TokenResetSenha[]
  pedidosComoGarcom    Pedido[]              @relation("PedidoGarcom")
  distribuicoesGorjeta DistribuicaoGorjeta[] @relation("DistribuicaoGarcom")
  fechamentosGorjetaCriados FechamentoGorjeta[] @relation("FechamentoCriadoPor")
  configuracoesGorjetaAlteradas ConfiguracaoGorjeta[] @relation("ConfiguracaoGorjetaAlteradaPor")
  aprovacoesSolicitadas AprovacaoGerencial[] @relation("AprovacaoSolicitante")
  aprovacoesConcedidas  AprovacaoGerencial[] @relation("AprovacaoAprovador")
  permissoesTemporariasRecebidas PermissaoTemporaria[] @relation("PermissaoTemporariaUsuario")
  permissoesTemporariasConcedidas PermissaoTemporaria[] @relation("PermissaoTemporariaConcedidaPor")

  @@map("usuarios")
}

model TokenResetSenha {
  id       String    @id @default(uuid())
  token    String    @unique
  expiraEm DateTime
  usadoEm  DateTime?
  criadoEm DateTime  @default(now())

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("tokens_reset_senha")
}

model Categoria {
  id       String   @id @default(uuid())
  nome     String
  ordem    Int      @default(0)
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  empresaId String
  empresa   Empresa   @relation(fields: [empresaId], references: [id])
  produtos  Produto[]

  @@map("categorias")
}

model Produto {
  id               String   @id @default(uuid())
  nome             String
  descricao        String?  @db.Text
  preco            Decimal  @db.Decimal(10, 2)
  precoPromocional Decimal? @db.Decimal(10, 2)
  imagemUrl        String?
  ingredientes     String?  @db.Text
  alergenos        String?  @db.Text
  disponivel       Boolean  @default(true)
  destaque         Boolean  @default(false)
  ordem            Int      @default(0)
  criadoEm         DateTime @default(now())

  // Estoque - identificacao
  sku          String?
  codigoBarras String?
  ncm          String?
  cest         String?
  unidade      String? @default("UN")
  marca        String?
  fabricante   String?
  localizacao  String?

  // Estoque - controle
  controlaEstoque  Boolean @default(false)
  controlaLote     Boolean @default(false)
  controlaValidade Boolean @default(false)
  estoqueAtual     Decimal @default(0) @db.Decimal(12, 3)
  estoqueMinimo    Decimal @default(0) @db.Decimal(12, 3)
  estoqueMaximo    Decimal @default(0) @db.Decimal(12, 3)
  pontoReposicao   Decimal @default(0) @db.Decimal(12, 3)

  // Estoque - custos e ficha tecnica
  custo  Decimal? @db.Decimal(10, 2)
  peso   Decimal? @db.Decimal(10, 3)
  volume Decimal? @db.Decimal(10, 3)

  // Impressao - setor de producao (para onde a comanda deste item deve ser roteada)
  setorProducao SetorProducao @default(COZINHA)

  empresaId            String
  empresa              Empresa               @relation(fields: [empresaId], references: [id])
  categoriaId          String
  categoria            Categoria             @relation(fields: [categoriaId], references: [id])
  adicionais           Adicional[]
  pedidoItens          PedidoItem[]
  lotes                Lote[]
  movimentacoesEstoque MovimentacaoEstoque[]
  favoritos            Favorito[]

  @@map("produtos")
}

model Fornecedor {
  id       String   @id @default(uuid())
  nome     String
  cnpjCpf  String?
  telefone String?
  email    String?
  endereco String?
  contato  String?
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  empresaId   String
  empresa     Empresa      @relation(fields: [empresaId], references: [id])
  lotes       Lote[]
  contasPagar ContaPagar[]

  @@map("fornecedores")
}

model CategoriaFinanceira {
  id       String                  @id @default(uuid())
  nome     String
  tipo     TipoCategoriaFinanceira
  ativo    Boolean                 @default(true)
  criadoEm DateTime                @default(now())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  contasPagar   ContaPagar[]
  contasReceber ContaReceber[]

  @@map("categorias_financeiras")
}

model ContaPagar {
  id             String          @id @default(uuid())
  descricao      String
  valor          Decimal         @db.Decimal(10, 2)
  vencimento     DateTime
  status         StatusConta     @default(PENDENTE)
  pagoEm         DateTime?
  valorPago      Decimal?        @db.Decimal(10, 2)
  formaPagamento FormaPagamento?
  observacoes    String?         @db.Text
  criadoEm       DateTime        @default(now())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  categoriaId String?
  categoria   CategoriaFinanceira? @relation(fields: [categoriaId], references: [id])

  fornecedorId String?
  fornecedor   Fornecedor? @relation(fields: [fornecedorId], references: [id])

  @@map("contas_pagar")
}

model ContaReceber {
  id             String          @id @default(uuid())
  descricao      String
  valor          Decimal         @db.Decimal(10, 2)
  vencimento     DateTime
  status         StatusConta     @default(PENDENTE)
  recebidoEm     DateTime?
  valorRecebido  Decimal?        @db.Decimal(10, 2)
  formaPagamento FormaPagamento?
  clienteNome    String?
  observacoes    String?         @db.Text
  criadoEm       DateTime        @default(now())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  categoriaId String?
  categoria   CategoriaFinanceira? @relation(fields: [categoriaId], references: [id])

  @@map("contas_receber")
}

model Cliente {
  id                 String    @id @default(uuid())
  nome               String?
  telefone           String
  email              String?
  senhaHash          String?
  dataNascimento     DateTime?
  saldoCashback      Decimal   @default(0) @db.Decimal(10, 2)
  aceitaComunicacoes Boolean   @default(true)
  ativo              Boolean   @default(true)
  excluidoEm         DateTime?
  criadoEm           DateTime  @default(now())
  ultimoAcessoEm     DateTime?

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  pedidos            Pedido[]
  avaliacoes         Avaliacao[]
  transacoesCashback TransacaoCashback[]
  enderecos          EnderecoCliente[]
  favoritos          Favorito[]
  conversasIA        ConversaIA[]
  acoesIA            AcaoIA[]

  @@unique([empresaId, telefone])
  @@map("clientes")
}

model EnderecoCliente {
  id              String   @id @default(uuid())
  apelido         String   @default("Casa")
  cep             String?
  endereco        String
  numero          String?
  complemento     String?
  bairro          String?
  cidade          String?
  estado          String?
  pontoReferencia String?
  principal       Boolean  @default(false)
  criadoEm        DateTime @default(now())

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@map("enderecos_cliente")
}

model Favorito {
  id       String   @id @default(uuid())
  criadoEm DateTime @default(now())

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@unique([clienteId, produtoId])
  @@map("favoritos")
}

model OtpCliente {
  id           String    @id @default(uuid())
  telefone     String
  codigoHash   String
  expiresAt    DateTime
  tentativas   Int       @default(0)
  verificadoEm DateTime?
  criadoEm     DateTime  @default(now())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  @@index([empresaId, telefone])
  @@map("otps_cliente")
}

model TransacaoCashback {
  id       String   @id @default(uuid())
  tipo     String
  valor    Decimal  @db.Decimal(10, 2)
  motivo   String?
  criadoEm DateTime @default(now())

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  @@map("transacoes_cashback")
}

model Cupom {
  id           String       @id @default(uuid())
  codigo       String
  tipoDesconto TipoDesconto
  valor        Decimal      @db.Decimal(10, 2)
  usoMaximo    Int?
  usosAtuais   Int          @default(0)
  validoAte    DateTime?
  ativo        Boolean      @default(true)
  criadoEm     DateTime     @default(now())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  pedidos   Pedido[]
  campanhas Campanha[]

  @@unique([empresaId, codigo])
  @@map("cupons")
}

model Campanha {
  id        String         @id @default(uuid())
  nome      String
  canal     CanalCampanha
  segmento  String
  texto     String?        @db.Text
  custo     Decimal?       @db.Decimal(10, 2)
  status    StatusCampanha @default(RASCUNHO)
  enviadaEm DateTime?
  criadoEm  DateTime       @default(now())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  cupomId String?
  cupom   Cupom?  @relation(fields: [cupomId], references: [id])

  @@map("campanhas")
}

model Avaliacao {
  id         String   @id @default(uuid())
  nota       Int
  comentario String?  @db.Text
  criadoEm   DateTime @default(now())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  pedidoId String @unique
  pedido   Pedido @relation(fields: [pedidoId], references: [id])

  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  @@map("avaliacoes")
}

model Lote {
  id             String    @id @default(uuid())
  numeroLote     String
  quantidade     Decimal   @db.Decimal(12, 3)
  custoUnitario  Decimal?  @db.Decimal(10, 2)
  dataFabricacao DateTime?
  dataValidade   DateTime?
  criadoEm       DateTime  @default(now())

  produtoId    String
  produto      Produto     @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  fornecedorId String?
  fornecedor   Fornecedor? @relation(fields: [fornecedorId], references: [id])

  movimentacoes MovimentacaoEstoque[]

  @@map("lotes")
}

model MovimentacaoEstoque {
  id            String                  @id @default(uuid())
  tipo          TipoMovimentacaoEstoque
  quantidade    Decimal                 @db.Decimal(12, 3)
  custoUnitario Decimal?                @db.Decimal(10, 2)
  motivo        String?
  criadoEm      DateTime                @default(now())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])
  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id])
  loteId    String?
  lote      Lote?   @relation(fields: [loteId], references: [id])
  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  @@map("movimentacoes_estoque")
}

model Adicional {
  id    String  @id @default(uuid())
  nome  String
  preco Decimal @db.Decimal(10, 2)
  ativo Boolean @default(true)

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@map("adicionais")
}

model ContadorPedido {
  id           String @id @default(uuid())
  ultimoNumero Int    @default(0)

  empresaId String  @unique
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  @@map("contadores_pedido")
}

model Mesa {
  id         String  @id @default(uuid())
  numero     Int
  capacidade Int     @default(4)
  ativo      Boolean @default(true)

  empresaId String
  empresa   Empresa   @relation(fields: [empresaId], references: [id])
  pedidos   Pedido[]
  reservas  Reserva[]

  @@unique([empresaId, numero])
  @@map("mesas")
}

model Reserva {
  id              String        @id @default(uuid())
  clienteNome     String
  clienteTelefone String?
  dataHora        DateTime
  pessoas         Int           @default(1)
  status          StatusReserva @default(CONFIRMADA)
  observacoes     String?       @db.Text
  criadoEm        DateTime      @default(now())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])
  mesaId    String?
  mesa      Mesa?   @relation(fields: [mesaId], references: [id])

  @@map("reservas")
}

model Pedido {
  id              String          @id @default(uuid())
  numero          Int
  tipo            TipoPedido
  status          StatusPedido    @default(RECEBIDO)
  clienteNome     String?
  clienteTelefone String?
  clienteEndereco String?         @db.Text
  formaPagamento  FormaPagamento?
  taxaEntrega     Decimal         @default(0) @db.Decimal(10, 2)
  valorTotal      Decimal         @db.Decimal(10, 2)
  observacoes     String?         @db.Text
  criadoEm        DateTime        @default(now())
  atualizadoEm    DateTime        @updatedAt

  canalEntrega  TipoCanalEntrega?
  taxaMotoboy   Decimal?          @db.Decimal(10, 2)
  idExterno     String?
  valorDesconto Decimal           @default(0) @db.Decimal(10, 2)
  garcomNome    String?
  origemPedido  String?           @default("PAINEL")

  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  mesaId    String?
  mesa      Mesa?    @relation(fields: [mesaId], references: [id])
  motoboyId String?
  motoboy   Motoboy? @relation(fields: [motoboyId], references: [id])
  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])
  cupomId   String?
  cupom     Cupom?   @relation(fields: [cupomId], references: [id])
  garcomId  String?
  garcom    Usuario? @relation("PedidoGarcom", fields: [garcomId], references: [id])

  // Gorjeta - sempre um retrato do momento da criacao, nunca recalculado depois
  gorjetaHabilitada Boolean  @default(false)
  gorjetaPercentual Decimal? @db.Decimal(5, 2)
  gorjetaValor      Decimal  @default(0) @db.Decimal(10, 2)

  fechamentoGorjetaId String?
  fechamentoGorjeta   FechamentoGorjeta? @relation(fields: [fechamentoGorjetaId], references: [id])

  itens       PedidoItem[]
  avaliacao   Avaliacao?
  printJobs   PrintJob[]
  aprovacoes  AprovacaoGerencial[]

  @@unique([empresaId, canalEntrega, idExterno])
  @@map("pedidos")
}

model Motoboy {
  id       String   @id @default(uuid())
  nome     String
  telefone String?
  veiculo  String?
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  pedidos   Pedido[]

  @@map("motoboys")
}

model ZonaEntrega {
  id               String  @id @default(uuid())
  bairro           String
  taxaEntrega      Decimal @db.Decimal(10, 2)
  tempoEstimadoMin Int?
  ativo            Boolean @default(true)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, bairro])
  @@map("zonas_entrega")
}

model CanalEntregaConfig {
  id           String           @id @default(uuid())
  tipo         TipoCanalEntrega
  ativo        Boolean          @default(false)
  webhookToken String           @unique @default(uuid())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, tipo])
  @@map("canais_entrega_config")
}

model Printer {
  id                 String                @id @default(uuid())
  nome               String
  descricao          String?
  setor              SetorProducao         @default(COZINHA)
  fabricante         String?
  modelo             String?
  tipoConexao        TipoConexaoImpressora @default(USB)
  identificadorLocal String? // nome da porta/impressora local (ex: "USB001") ou host:porta de rede - usado pelo agente local, nunca pelo navegador
  larguraPapelMm     Int                   @default(80)
  caracteresPorLinha Int                   @default(48)
  copias             Int                   @default(1)
  ativa              Boolean               @default(true)
  padrao             Boolean               @default(false)
  status             StatusImpressora      @default(OFFLINE)
  ultimaImpressaoEm  DateTime?
  ultimoErro         String?               @db.Text
  criadoEm           DateTime              @default(now())

  empresaId String
  empresa   Empresa    @relation(fields: [empresaId], references: [id])
  printJobs PrintJob[]

  @@map("impressoras")
}

model PrintJob {
  id            String                 @id @default(uuid())
  tipoDocumento TipoDocumentoImpressao
  setor         SetorProducao
  status        StatusPrintJob         @default(PENDING)
  prioridade    PrioridadePrintJob     @default(NORMAL)
  payload       String                 @db.Text // JSON com o conteudo ja formatado da comanda
  tentativas    Int                    @default(0)
  erro          String?                @db.Text
  criadoEm      DateTime               @default(now())
  impressoEm    DateTime?

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])
  printerId String
  printer   Printer @relation(fields: [printerId], references: [id])
  pedidoId  String?
  pedido    Pedido? @relation(fields: [pedidoId], references: [id])

  logs PrintLog[]

  @@index([empresaId, status])
  @@map("print_jobs")
}

model PrintLog {
  id       String   @id @default(uuid())
  acao     String // CRIADO, IMPRESSO, FALHOU, REIMPRESSAO, CANCELADO
  detalhe  String?  @db.Text
  criadoEm DateTime @default(now())

  printJobId String
  printJob   PrintJob @relation(fields: [printJobId], references: [id], onDelete: Cascade)
  usuarioId  String?
  usuario    Usuario? @relation(fields: [usuarioId], references: [id])

  @@map("print_logs")
}

model PedidoItem {
  id             String        @id @default(uuid())
  nomeProduto    String
  precoUnitario  Decimal       @db.Decimal(10, 2)
  quantidade     Int           @default(1)
  observacoes    String?       @db.Text
  adicionaisJson String?       @db.Text
  setorProducao  SetorProducao @default(COZINHA)

  pedidoId  String
  pedido    Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produtoId String?
  produto   Produto? @relation(fields: [produtoId], references: [id])

  @@map("pedido_itens")
}

model Caixa {
  id                    String      @id @default(uuid())
  status                StatusCaixa @default(ABERTO)
  valorAbertura         Decimal     @db.Decimal(10, 2)
  valorFechamento       Decimal?    @db.Decimal(10, 2)
  observacoesAbertura   String?     @db.Text
  observacoesFechamento String?     @db.Text
  abertoEm              DateTime    @default(now())
  fechadoEm             DateTime?

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  usuarioAberturaId String
  usuarioAbertura   Usuario @relation("CaixaAbertoPor", fields: [usuarioAberturaId], references: [id])

  usuarioFechamentoId String?
  usuarioFechamento   Usuario? @relation("CaixaFechadoPor", fields: [usuarioFechamentoId], references: [id])

  movimentacoes MovimentacaoCaixa[]

  @@map("caixas")
}

model MovimentacaoCaixa {
  id       String                @id @default(uuid())
  tipo     TipoMovimentacaoCaixa
  valor    Decimal               @db.Decimal(10, 2)
  motivo   String
  criadoEm DateTime              @default(now())

  caixaId String
  caixa   Caixa  @relation(fields: [caixaId], references: [id], onDelete: Cascade)

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  @@map("movimentacoes_caixa")
}

enum CanalIA {
  PAINEL_ADMIN
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  SITE
  APP
  TELEGRAM
  EMAIL
}

enum PapelMensagemIA {
  USUARIO
  ASSISTENTE
  FERRAMENTA
}

enum TipoAcaoIA {
  PERGUNTA_RESPONDIDA
  PEDIDO_CRIADO
  PROMOCAO_CRIADA
  CAMPANHA_CRIADA
  RELATORIO_GERADO
  TAREFA_CRIADA
}

enum StatusTarefaIA {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
}

model ConversaIA {
  id           String   @id @default(uuid())
  canal        CanalIA  @default(PAINEL_ADMIN)
  titulo       String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  mensagens MensagemIA[]
  acoes     AcaoIA[]

  @@map("conversas_ia")
}

model MensagemIA {
  id              String          @id @default(uuid())
  papel           PapelMensagemIA
  conteudo        String          @db.Text
  ferramentaUsada String?
  criadoEm        DateTime        @default(now())

  conversaId String
  conversa   ConversaIA @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  @@map("mensagens_ia")
}

model AcaoIA {
  id           String     @id @default(uuid())
  tipo         TipoAcaoIA
  referenciaId String?
  detalhe      String?    @db.Text
  criadoEm     DateTime   @default(now())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  conversaId String?
  conversa   ConversaIA? @relation(fields: [conversaId], references: [id])

  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  @@map("acoes_ia")
}

model TarefaIA {
  id          String         @id @default(uuid())
  titulo      String
  descricao   String?        @db.Text
  status      StatusTarefaIA @default(PENDENTE)
  criadoEm    DateTime       @default(now())
  concluidaEm DateTime?

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  @@map("tarefas_ia")
}

model ConfiguracaoGorjeta {
  id                      String  @id @default(uuid())
  ativa                   Boolean @default(false)
  percentualPadrao        Decimal @default(10) @db.Decimal(5, 2)
  permitirClienteEscolher Boolean @default(true)
  opcoesPercentual        String  @default("[5,10,12,15]")
  permitirValorFixo       Boolean @default(false)

  modeloDistribuicao ModeloDistribuicaoGorjeta @default(INDIVIDUAL)
  regraRateio        RegraRateioGorjeta        @default(IGUAL)

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  empresaId String  @unique
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  atualizadoPorId String?
  atualizadoPor   Usuario? @relation("ConfiguracaoGorjetaAlteradaPor", fields: [atualizadoPorId], references: [id])

  @@map("configuracoes_gorjeta")
}

enum ModeloDistribuicaoGorjeta {
  INDIVIDUAL
  COLETIVO
}

enum RegraRateioGorjeta {
  IGUAL
  PERCENTUAL
  HORAS
  PONTOS
}

enum StatusFechamentoGorjeta {
  CONFIRMADO
  CANCELADO
}

enum StatusDistribuicaoGorjeta {
  PENDENTE
  PAGO
  CANCELADO
}

model FechamentoGorjeta {
  id                 String                    @id @default(uuid())
  periodoInicio      DateTime
  periodoFim         DateTime
  modeloDistribuicao ModeloDistribuicaoGorjeta
  regraRateio        RegraRateioGorjeta?
  totalVendido       Decimal                   @db.Decimal(12, 2)
  totalGorjetas      Decimal                   @db.Decimal(10, 2)
  status             StatusFechamentoGorjeta   @default(CONFIRMADO)
  observacao         String?                   @db.Text
  criadoEm           DateTime                  @default(now())
  canceladoEm        DateTime?

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  criadoPorId String
  criadoPor   Usuario @relation("FechamentoCriadoPor", fields: [criadoPorId], references: [id])

  distribuicoes DistribuicaoGorjeta[]
  pedidos       Pedido[]

  @@map("fechamentos_gorjeta")
}

model DistribuicaoGorjeta {
  id             String                    @id @default(uuid())
  valor          Decimal                   @db.Decimal(10, 2)
  criterioTexto  String?
  status         StatusDistribuicaoGorjeta @default(PENDENTE)
  pagoEm         DateTime?
  formaPagamento String?
  observacao     String?                   @db.Text
  criadoEm       DateTime                  @default(now())

  fechamentoId String
  fechamento   FechamentoGorjeta @relation(fields: [fechamentoId], references: [id], onDelete: Cascade)

  garcomId String
  garcom   Usuario @relation("DistribuicaoGarcom", fields: [garcomId], references: [id])

  @@map("distribuicoes_gorjeta")
}

// Catalogo global de permissoes do sistema (mesmo catalogo pra todas as empresas).
// Convencao de chave: "modulo.acao", ex: "financeiro.visualizar".
model Permissao {
  id        String   @id @default(uuid())
  chave     String   @unique
  modulo    String
  acao      String
  descricao String
  criadoEm  DateTime @default(now())

  perfisPadrao       PerfilPermissaoPadrao[]
  perfisPersonalizados PerfilPersonalizadoPermissao[]
  concessoesTemporarias PermissaoTemporaria[]

  @@index([modulo])
  @@map("permissoes")
}

// Concede uma permissao extra, pontual, a um usuario especifico ate uma data/hora - sem precisar
// criar um perfil personalizado pra isso. Efetiva enquanto revogadaEm for nulo e validaAte for
// no futuro; nao criamos linha por dia/turno, so uma janela de validade simples.
model PermissaoTemporaria {
  id         String    @id @default(uuid())
  validaAte  DateTime
  motivo     String?
  criadoEm   DateTime  @default(now())
  revogadaEm DateTime?

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  usuarioId String
  usuario   Usuario @relation("PermissaoTemporariaUsuario", fields: [usuarioId], references: [id])

  permissaoId String
  permissao   Permissao @relation(fields: [permissaoId], references: [id])

  concedidaPorId String
  concedidaPor   Usuario @relation("PermissaoTemporariaConcedidaPor", fields: [concedidaPorId], references: [id])

  @@index([usuarioId, revogadaEm, validaAte])
  @@map("permissoes_temporarias")
}

// Perfil criado pela propria empresa, com um recorte de permissoes escolhido a dedo. Quando um
// usuario tem um perfil personalizado atribuido, as permissoes dele passam a vir do perfil, nao
// mais do papel padrao - o papel (PapelUsuario) continua existindo pra outras regras de negocio
// (ex: rateio de gorjeta), so a checagem de permissao muda de fonte.
model PerfilPersonalizado {
  id           String   @id @default(uuid())
  nome         String
  descricao    String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  permissoes PerfilPersonalizadoPermissao[]
  usuarios   Usuario[]

  @@unique([empresaId, nome])
  @@map("perfis_personalizados")
}

model PerfilPersonalizadoPermissao {
  id String @id @default(uuid())

  perfilId String
  perfil   PerfilPersonalizado @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  permissaoId String
  permissao   Permissao @relation(fields: [permissaoId], references: [id], onDelete: Cascade)

  @@unique([perfilId, permissaoId])
  @@map("perfis_personalizados_permissoes")
}

// Permissoes padrao de cada papel base (SUPER_ADMIN, ADMIN, GERENTE, FUNCIONARIO, GARCOM).
// Serve de ponto de partida antes de existirem perfis personalizados por empresa.
model PerfilPermissaoPadrao {
  id          String    @id @default(uuid())
  papel       PapelUsuario
  permissaoId String
  permissao   Permissao @relation(fields: [permissaoId], references: [id], onDelete: Cascade)

  @@unique([papel, permissaoId])
  @@index([papel])
  @@map("perfis_permissao_padrao")
}

// Limite (por papel, por empresa) de desconto que dispensa aprovacao de um superior.
// Sem registro pra um papel = sem excecao possivel: toda solicitacao desse papel exige aprovacao.
model LimiteAprovacao {
  id                       String       @id @default(uuid())
  papel                    PapelUsuario
  limiteDescontoPercentual Decimal?     @db.Decimal(5, 2)
  limiteDescontoValor      Decimal?     @db.Decimal(10, 2)
  atualizadoEm             DateTime     @updatedAt

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, papel])
  @@map("limites_aprovacao")
}

enum TipoAprovacaoGerencial {
  DESCONTO
  CANCELAMENTO
}

// Registro de toda vez que um desconto/cancelamento passou do limite de quem pediu e precisou
// do PIN de um aprovador. E o rastro de auditoria minimo desse fluxo.
model AprovacaoGerencial {
  id          String                  @id @default(uuid())
  tipo        TipoAprovacaoGerencial
  valorAntes  Decimal?                @db.Decimal(10, 2)
  valorDepois Decimal?                @db.Decimal(10, 2)
  percentual  Decimal?                @db.Decimal(5, 2)
  motivo      String?                 @db.Text
  criadoEm    DateTime                @default(now())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  pedidoId String
  pedido   Pedido @relation(fields: [pedidoId], references: [id])

  solicitanteId String
  solicitante   Usuario @relation("AprovacaoSolicitante", fields: [solicitanteId], references: [id])

  aprovadorId String
  aprovador   Usuario @relation("AprovacaoAprovador", fields: [aprovadorId], references: [id])

  @@map("aprovacoes_gerenciais")
}
