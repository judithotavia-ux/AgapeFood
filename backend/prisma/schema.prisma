generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PapelUsuario {
  SUPER_ADMIN
  ADMIN
  GERENTE
  FUNCIONARIO
}

enum TipoPedido {
  DELIVERY
  RETIRADA
  BALCAO
  MESA
}

enum StatusPedido {
  RECEBIDO
  PREPARANDO
  PRONTO
  SAIU_PARA_ENTREGA
  ENTREGUE
  CANCELADO
}

enum FormaPagamento {
  PIX
  CARTAO
  DINHEIRO
  VALE_ALIMENTACAO
}

enum StatusCaixa {
  ABERTO
  FECHADO
}

enum TipoMovimentacaoCaixa {
  SANGRIA
  SUPRIMENTO
}

enum StatusReserva {
  CONFIRMADA
  CANCELADA
  CONCLUIDA
}

enum TipoCanalEntrega {
  MOTOBOY_PROPRIO
  IFOOD
  UBER_EATS
  NOVENTA_NOVE_FOOD
}

model Empresa {
  id        String   @id @default(uuid())
  nome      String
  slug      String   @unique
  logoUrl   String?
  corPrimaria String @default("#D4AF37")
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  usuarios   Usuario[]
  categorias Categoria[]
  produtos   Produto[]
  pedidos    Pedido[]
  mesas      Mesa[]
  caixas     Caixa[]
  reservas   Reserva[]
  motoboys   Motoboy[]
  zonasEntrega ZonaEntrega[]
  canaisEntrega CanalEntregaConfig[]
  contadorPedido ContadorPedido?

  @@map("empresas")
}

model Usuario {
  id        String       @id @default(uuid())
  nome      String
  email     String       @unique
  senhaHash String
  papel     PapelUsuario @default(FUNCIONARIO)
  ativo     Boolean      @default(true)
  criadoEm  DateTime     @default(now())
  ultimoLoginEm DateTime?

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  caixasAbertos      Caixa[]             @relation("CaixaAbertoPor")
  caixasFechados     Caixa[]             @relation("CaixaFechadoPor")
  movimentacoesCaixa MovimentacaoCaixa[]

  @@map("usuarios")
}

model Categoria {
  id        String   @id @default(uuid())
  nome      String
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  empresaId String
  empresa   Empresa   @relation(fields: [empresaId], references: [id])
  produtos  Produto[]

  @@map("categorias")
}

model Produto {
  id                String   @id @default(uuid())
  nome              String
  descricao         String?  @db.Text
  preco             Decimal  @db.Decimal(10, 2)
  precoPromocional  Decimal? @db.Decimal(10, 2)
  imagemUrl         String?
  ingredientes      String?  @db.Text
  alergenos         String?  @db.Text
  disponivel        Boolean  @default(true)
  destaque          Boolean  @default(false)
  ordem             Int      @default(0)
  criadoEm          DateTime @default(now())

  empresaId   String
  empresa     Empresa   @relation(fields: [empresaId], references: [id])
  categoriaId String
  categoria   Categoria @relation(fields: [categoriaId], references: [id])
  adicionais  Adicional[]
  pedidoItens PedidoItem[]

  @@map("produtos")
}

model Adicional {
  id     String  @id @default(uuid())
  nome   String
  preco  Decimal @db.Decimal(10, 2)
  ativo  Boolean @default(true)

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@map("adicionais")
}

model ContadorPedido {
  id            String @id @default(uuid())
  ultimoNumero  Int    @default(0)

  empresaId String  @unique
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  @@map("contadores_pedido")
}

model Mesa {
  id         String  @id @default(uuid())
  numero     Int
  capacidade Int     @default(4)
  ativo      Boolean @default(true)

  empresaId String
  empresa   Empresa   @relation(fields: [empresaId], references: [id])
  pedidos   Pedido[]
  reservas  Reserva[]

  @@unique([empresaId, numero])
  @@map("mesas")
}

model Reserva {
  id              String        @id @default(uuid())
  clienteNome     String
  clienteTelefone String?
  dataHora        DateTime
  pessoas         Int           @default(1)
  status          StatusReserva @default(CONFIRMADA)
  observacoes     String?       @db.Text
  criadoEm        DateTime      @default(now())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])
  mesaId    String?
  mesa      Mesa?   @relation(fields: [mesaId], references: [id])

  @@map("reservas")
}

model Pedido {
  id               String         @id @default(uuid())
  numero           Int
  tipo             TipoPedido
  status           StatusPedido   @default(RECEBIDO)
  clienteNome      String?
  clienteTelefone  String?
  clienteEndereco  String?        @db.Text
  formaPagamento   FormaPagamento?
  taxaEntrega      Decimal        @default(0) @db.Decimal(10, 2)
  valorTotal       Decimal        @db.Decimal(10, 2)
  observacoes      String?        @db.Text
  criadoEm         DateTime       @default(now())
  atualizadoEm     DateTime       @updatedAt

  canalEntrega TipoCanalEntrega?
  taxaMotoboy  Decimal?          @db.Decimal(10, 2)
  idExterno    String?

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])
  mesaId    String?
  mesa      Mesa?   @relation(fields: [mesaId], references: [id])
  motoboyId String?
  motoboy   Motoboy? @relation(fields: [motoboyId], references: [id])

  itens PedidoItem[]

  @@unique([empresaId, canalEntrega, idExterno])
  @@map("pedidos")
}

model Motoboy {
  id        String  @id @default(uuid())
  nome      String
  telefone  String?
  veiculo   String?
  ativo     Boolean @default(true)
  criadoEm  DateTime @default(now())

  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  pedidos   Pedido[]

  @@map("motoboys")
}

model ZonaEntrega {
  id                 String  @id @default(uuid())
  bairro             String
  taxaEntrega        Decimal @db.Decimal(10, 2)
  tempoEstimadoMin   Int?
  ativo              Boolean @default(true)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, bairro])
  @@map("zonas_entrega")
}

model CanalEntregaConfig {
  id            String           @id @default(uuid())
  tipo          TipoCanalEntrega
  ativo         Boolean          @default(false)
  webhookToken  String           @unique @default(uuid())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, tipo])
  @@map("canais_entrega_config")
}

model PedidoItem {
  id             String  @id @default(uuid())
  nomeProduto    String
  precoUnitario  Decimal @db.Decimal(10, 2)
  quantidade     Int     @default(1)
  observacoes    String? @db.Text
  adicionaisJson String? @db.Text

  pedidoId  String
  pedido    Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produtoId String?
  produto   Produto? @relation(fields: [produtoId], references: [id])

  @@map("pedido_itens")
}

model Caixa {
  id                     String      @id @default(uuid())
  status                 StatusCaixa @default(ABERTO)
  valorAbertura          Decimal     @db.Decimal(10, 2)
  valorFechamento        Decimal?    @db.Decimal(10, 2)
  observacoesAbertura    String?     @db.Text
  observacoesFechamento  String?     @db.Text
  abertoEm               DateTime    @default(now())
  fechadoEm              DateTime?

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  usuarioAberturaId String
  usuarioAbertura   Usuario @relation("CaixaAbertoPor", fields: [usuarioAberturaId], references: [id])

  usuarioFechamentoId String?
  usuarioFechamento   Usuario? @relation("CaixaFechadoPor", fields: [usuarioFechamentoId], references: [id])

  movimentacoes MovimentacaoCaixa[]

  @@map("caixas")
}

model MovimentacaoCaixa {
  id       String                 @id @default(uuid())
  tipo     TipoMovimentacaoCaixa
  valor    Decimal                @db.Decimal(10, 2)
  motivo   String
  criadoEm DateTime               @default(now())

  caixaId String
  caixa   Caixa @relation(fields: [caixaId], references: [id], onDelete: Cascade)

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  @@map("movimentacoes_caixa")
}
