generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PapelUsuario {
  SUPER_ADMIN
  ADMIN
  GERENTE
  FUNCIONARIO
}

model Empresa {
  id        String   @id @default(uuid())
  nome      String
  slug      String   @unique
  logoUrl   String?
  corPrimaria String @default("#D4AF37")
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  usuarios   Usuario[]
  categorias Categoria[]
  produtos   Produto[]

  @@map("empresas")
}

model Usuario {
  id        String       @id @default(uuid())
  nome      String
  email     String       @unique
  senhaHash String
  papel     PapelUsuario @default(FUNCIONARIO)
  ativo     Boolean      @default(true)
  criadoEm  DateTime     @default(now())
  ultimoLoginEm DateTime?

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  @@map("usuarios")
}

model Categoria {
  id        String   @id @default(uuid())
  nome      String
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  empresaId String
  empresa   Empresa   @relation(fields: [empresaId], references: [id])
  produtos  Produto[]

  @@map("categorias")
}

model Produto {
  id                String   @id @default(uuid())
  nome              String
  descricao         String?  @db.Text
  preco             Decimal  @db.Decimal(10, 2)
  precoPromocional  Decimal? @db.Decimal(10, 2)
  imagemUrl         String?
  ingredientes      String?  @db.Text
  alergenos         String?  @db.Text
  disponivel        Boolean  @default(true)
  destaque          Boolean  @default(false)
  ordem             Int      @default(0)
  criadoEm          DateTime @default(now())

  empresaId   String
  empresa     Empresa   @relation(fields: [empresaId], references: [id])
  categoriaId String
  categoria   Categoria @relation(fields: [categoriaId], references: [id])
  adicionais  Adicional[]

  @@map("produtos")
}

model Adicional {
  id     String  @id @default(uuid())
  nome   String
  preco  Decimal @db.Decimal(10, 2)
  ativo  Boolean @default(true)

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@map("adicionais")
}
