# Agape IA - cada empresa configura e paga sua propria chave da Anthropic pelo painel (Agape IA > Configurar chave).
# ENCRYPTION_KEY e so a chave usada pra criptografar essas chaves de cliente no banco - gere uma vez com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANTE: trocar essa chave depois de ja existirem empresas com chave salva torna as chaves salvas ilegiveis.
ENCRYPTION_KEY=""

# Cobranca de assinatura via Asaas (opcional - sem isso, empresas ficam em TRIAL indefinidamente ate configurar)
# Sandbox: https://api-sandbox.asaas.com/v3 | Producao: https://api.asaas.com/v3
ASAAS_BASE_URL="https://api-sandbox.asaas.com/v3"
ASAAS_API_KEY=""
# Token que voce escolhe e cadastra tanto aqui quanto no webhook criado no painel do Asaas
ASAAS_WEBHOOK_TOKEN=""
